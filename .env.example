# Django backend environment variables.
# Copy to .env and fill in real values — never commit secrets.

DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=False
# Comma-separated list of allowed hosts e.g. diploman.co,www.diploman.co
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Comma-separated CORS origins e.g. https://diploman.co
CORS_ALLOWED_ORIGINS=

DB_NAME=diplomandb
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost

EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
